{
  "name": "data-sheet",
  "private": true,
  "version": "1.0.0",
  "description": "A simple data entry tool that saves documents to a folder on your own computer and exports them as PDF.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "check": "SKIP_PUBLIC=1 vite build --ssr scripts/check.mjs --outDir .tmp-check --logLevel error && node .tmp-check/check.js",
    "test": "npm run check"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
